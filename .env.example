# Runtime
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001

# Local PostgreSQL only. Replace placeholders in an uncommitted .env file.
POSTGRES_DB=railos
POSTGRES_USER=railos
POSTGRES_PASSWORD=<set-locally>
DATABASE_URL=postgresql://railos:<set-locally>@localhost:5432/railos

# XRPL Testnet only. Never place a mainnet seed in this project.
XRPL_NETWORK=testnet
XRPL_TESTNET_URL=wss://s.altnet.rippletest.net:51233
XRPL_TESTNET_SOURCE_ADDRESS=
XRPL_TESTNET_SOURCE_SEED=
XRPL_TESTNET_DESTINATION_ADDRESS=

# External boundaries remain disabled until separately verified.
KALEIDO_ENABLED=false
CUSTODY_ENABLED=false
BNY_ENABLED=false
